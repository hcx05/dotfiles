/* ============================================================================
 * Rofi config -- futuristic command palette
 * Colors come from ~/.config/rofi/colors.rasi, generated from
 * ~/.config/rice/theme.conf by ~/.config/rice/apply-theme.sh.
 * This file is safe to hand-edit for layout/behavior.
 *
 * Sizes: everything is in em (1em = one line of the menu font), nothing in
 * px -- so the whole menu keeps its proportions at any text size. The text
 * size itself follows the display scale: scale.rasi (generated like
 * colors.rasi) sets rofi's dpi to the one ~/.config/rice/scale/autoscale
 * detected for the current screen. Keep new sizes in em for the same reason.
 * ============================================================================ */

@import "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/scale.rasi"

configuration {
    modi:                       "drun,window,run,ssh";
    show-icons:                 true;
    icon-theme:                 "candy-icons";
    display-drun:               " Apps";
    display-window:             " Windows";
    display-run:                " Run";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 11";
    disable-history:            false;
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

* {
    background-color:  transparent;
    text-color:         @fg;
    border-color:       @border-active;
}

window {
    location:        center;
    anchor:           center;
    width:            30em;
    background-color: @bg-trans;
    border:           0.07em;
    border-radius:    0.5em;
    padding:          0em;
}

mainbox {
    background-color: transparent;
    padding:           0.7em;
    children:          [ "inputbar", "message", "listview" ];
    spacing:           0.5em;
}

inputbar {
    background-color: @bg-alt;
    text-color:         @fg;
    border-radius:      0.4em;
    padding:             0.5em 0.7em;
    spacing:             0.4em;
    children:            [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color:        @fg;
    placeholder:        "Search...";
    placeholder-color:  @fg-alt;
}

message {
    background-color: @bg-alt;
    border-radius:       0.4em;
    padding:              0.4em 0.6em;
    text-color:           @fg-alt;
}

listview {
    background-color: transparent;
    columns:            1;
    lines:               8;
    spacing:             0.2em;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
}

element {
    background-color: transparent;
    text-color:         @fg;
    border-radius:      0.4em;
    padding:             0.4em 0.5em;
    spacing:             0.5em;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:         @fg;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color:         @bg;
}

element-icon {
    size:      1.1em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}
