# ============================================================================
# i3 config -- futuristic Kali cybersecurity workstation rice
# Colors come from ~/.config/i3/colors.conf, generated from
# ~/.config/rice/theme.conf by ~/.config/rice/apply-theme.sh.
# This file is safe to hand-edit for structure/keybinds/behavior.
# ============================================================================

set $mod Mod4

font pango:JetBrainsMono Nerd Font 10

# BEGIN GENERATED COLORS (regenerated by ~/.config/rice/apply-theme.sh)
set $bg          #0A0A0A
set $bg_alt      #1C1C1C
set $fg          #E8E8E8
set $fg_alt      #8A8A8A
set $accent      #FFFFFF
set $accent_alt  #BDBDBD
set $border_active   #FFFFFF
set $border_inactive #2E2E2E
set $urgent      #FF1855
# END GENERATED COLORS

# ---------------------------------------------------------------------------
# Look & feel: gaps, borders, focus indication
# ---------------------------------------------------------------------------
gaps inner 14
gaps outer -10
smart_gaps off

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none

# Per-layout overrides of the gaps above (theme.conf's LAYOUT): the "dock"
# layout's top bar and right-side dock are override-redirect, so gaps are
# what keeps tiled windows off them.
# BEGIN GENERATED LAYOUT (regenerated by ~/.config/rice/apply-theme.sh)
smart_gaps off
gaps outer -10
gaps top 28
gaps right 24
# END GENERATED LAYOUT

# class                 border          background      text    indicator   child_border
client.focused          $border_active  $bg             $fg     $accent     $border_active
client.focused_inactive $border_inactive $bg            $fg_alt $border_inactive $border_inactive
client.unfocused        $border_inactive $bg            $fg_alt $border_inactive $border_inactive
client.urgent           $urgent         $bg             $fg     $urgent     $urgent
client.placeholder      $bg             $bg             $fg     $bg         $bg
client.background       $bg

# no native i3bar -- polybar replaces it entirely (started in exec block below)

# ---------------------------------------------------------------------------
# Autostart
# ---------------------------------------------------------------------------
# i3 does NOT process /etc/xdg/autostart or ~/.config/autostart on its own
# (unlike XFCE/GNOME session managers) -- dex runs those .desktop entries
# once at startup. This is what starts the VMware clipboard/drag-drop
# integration (vmware-user.desktop -> vmware-user-suid-wrapper) and any
# other autostart apps that don't have an explicit exec line below.
exec --no-startup-id dex -a
exec_always --no-startup-id gsettings set org.freedesktop.ibus.panel show-icon-on-systray false
exec --no-startup-id numlockx on
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id picom --config ~/.config/picom/picom.conf -b
exec --no-startup-id dunst
exec --no-startup-id ~/.config/i3/set-wallpaper.sh
# exec_always (not plain exec): each daemon below self-guards with a flock
# (same pattern as clipd.py), so a reload/restart re-running this line just
# exits immediately if one is already running instead of stacking another
# -- that's what makes it safe to use exec_always instead of plain exec
# here, unlike most of the autostart block above.
exec_always --no-startup-id python3 ~/.config/i3/alt-tab.py daemon
# Makes newly-opened windows map already maximized below the top bar (see
# comment on the for_window catch-all below) instead of a small fixed size.
exec_always --no-startup-id python3 ~/.config/i3/default-size.py daemon
# Re-snaps already-maximized floating windows back below the top bar after
# an output change (observed cause: resuming the VM from suspend makes the
# virtual display re-probe its mode, and i3's own floating-window-stays-
# on-screen clamping doesn't know about the bar's reserved strip -- see the
# script's docstring).
exec_always --no-startup-id python3 ~/.config/i3/fix-maximized-on-output-change.py daemon
# Clipboard history daemon -- records the X CLIPBOARD selection so $mod+c can
# offer it back (see ~/.config/rice/clipboard/). Self-guards with a flock, so
# an i3 reload/restart re-running this line is a harmless no-op.
exec --no-startup-id python3 ~/.config/rice/clipboard/clipd.py
# polkit-mate-authentication-agent-1 and nm-applet are now started by
# `dex -a` above (their /etc/xdg/autostart entries only exclude GNOME/KDE,
# so they run under i3 too) -- do not exec them again here, that would
# launch duplicate instances.
# xfce4-power-manager's autostart entry is OnlyShowIn=XFCE, so dex skips it
# under i3 -- it still needs its own exec line here.
exec --no-startup-id xfce4-power-manager
# Desktop right-click menu ("桌面右鍵選單") -- global button-3 grab that
# replays every click normally and ALSO runs desktop-menu.sh, which only
# actually shows anything when the click landed on bare background. -f
# points it at a rice-specific config instead of the default ~/.xbindkeysrc
# so it doesn't collide with any other xbindkeys use on this machine.
# exec_always (not plain exec): plain `exec` lines are documented to NOT
# re-run on `i3 restart` (only on a fresh i3 start/login) -- confirmed live
# in this session (a restart never relaunched a plain-exec xbindkeys).
# pkill-then-relaunch (quoted as one shell command -- an unquoted `;` would
# be parsed by i3 itself as an IPC command separator, not handed to the
# shell) so repeated restarts don't stack duplicate instances fighting over
# the same button-3 grab.
exec_always --no-startup-id "pkill -x xbindkeys; sleep 0.2; xbindkeys -f ~/.config/i3/xbindkeysrc"
# Right Shift, tapped alone (not held with another key), toggles English/
# Zhuyin input -- ported from gh0stzk's sxhkd setup (xcape -e
# 'Shift_R=XF86Launch1', paired with the XF86Launch1 bindsym above).
# -t 150: tap must release within 150ms to count as "alone" -- xcape's own
# default. exec_always/pkill-first for the same reason as xbindkeys above
# (plain `exec` doesn't rerun on `i3 restart`, only on a fresh i3 start).
exec_always --no-startup-id "pkill -x xcape; sleep 0.2; xcape -e 'Shift_R=XF86Launch1' -t 150"

# ---------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------
floating_modifier $mod
focus_follows_mouse yes
mouse_warping output
focus_on_window_activation smart
workspace_layout default
# A fullscreen app keeps ownership of the screen; only popups from it show.
popup_during_fullscreen smart
# Urgent windows (e.g. a chat ping) flash their border for 500 ms and then
# settle -- the border colour comes from client.urgent above.
force_display_urgency_hint 500 ms

# Unconstrained on purpose: the F11 maximize-below-top-bar toggle
# (~/.config/i3/maximize-toggle.py) needs to resize floating windows up to
# nearly the full output, which floating_maximum_size would otherwise cap.
# New windows are sized the same way, by ~/.config/i3/default-size.py (see
# the Autostart block and the for_window catch-all further down).
floating_maximum_size -1 x -1
# no titlebars in this config (default_border pixel, not normal) -- "titlebar"
# drag mode would have nothing to grab, so use plain "modifier": hold $mod
# and left-click-drag anywhere on a tiled window to reorder/move it.
tiling_drag modifier

# ---------------------------------------------------------------------------
# Application launch / control
# ---------------------------------------------------------------------------
bindsym $mod+Return exec kitty
bindsym $mod+d exec rofi -show drun -config ~/.config/rofi/config.rasi
# NOTE: deliberately NOT bound to $mod+space. The chewing engine's own
# package file (/usr/share/ibus/component/chewing.xml) hardcodes
# "Super+space" as its own "switch to me" hotkey at the ibus-daemon level,
# independent of gsettings. Some apps that route keys to ibus via the IBus
# IM protocol (XIM-bridged terminals, Java/Swing apps like Burp) can hand
# Super+space straight to ibus instead of us, silently forcing chewing on
# -- this was the actual root cause of ibus "randomly" reverting to
# Chinese. $mod+i avoids the collision entirely (nothing else claims it).
bindsym $mod+i exec --no-startup-id ~/.config/i3/toggle-ibus.sh
# Tap Right Shift alone -> same toggle, ported from gh0stzk's sxhkd setup
# (xcape turns a lone Shift_R tap into XF86Launch1; see the exec_always
# line in the Autostart block below for the xcape daemon itself).
bindsym XF86Launch1 exec --no-startup-id ~/.config/i3/toggle-ibus.sh
bindsym $mod+Tab exec rofi -show window -config ~/.config/rofi/config.rasi
# Clipboard history menu -- pick a past clip and it's pasted straight into
# the window you were in (terminals get ctrl+shift+v, GUI apps ctrl+v). Bound
# to $mod+v (v = paste); NOT plain ctrl+v, which would hijack paste globally.
bindsym $mod+v exec --no-startup-id python3 ~/.config/rice/clipboard/clipmenu.py
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3? This ends your session.' -B 'Yes, exit' 'i3-msg exit'
# Power menu -- same rofi menu (Lock/Logout/Suspend/Reboot/Shut Down) as
# clicking the icon at the top-left of the polybar bar.
bindsym $mod+Shift+p exec --no-startup-id ~/.config/rofi/scripts/powermenu.sh

# ---------------------------------------------------------------------------
# Alt+Tab -- MRU window cycling (Windows/XFCE-style: hold Alt, tap Tab to
# step back through recently-focused windows, release Alt to land on one).
# Handled in default mode so i3 never gets trapped in a submode if X11's
# Alt_L KeyRelease event carries Mod1Mask or fires before mode entry;
# alt-tab.py watches XQueryKeymap for Alt release and commits the MRU order.
# ---------------------------------------------------------------------------
bindsym Mod1+Tab exec --no-startup-id python3 ~/.config/i3/alt-tab.py step
bindsym Mod1+Shift+Tab exec --no-startup-id python3 ~/.config/i3/alt-tab.py step-back

# ---------------------------------------------------------------------------
# Focus movement (vim-style + arrows)
# ---------------------------------------------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ---------------------------------------------------------------------------
# Move windows
# ---------------------------------------------------------------------------
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ---------------------------------------------------------------------------
# Layout / floating / fullscreen
# ---------------------------------------------------------------------------
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
# F11: "maximize" a floating window to fill the space below the top bar
# -- NOT i3's fullscreen (that covers the top bar too). This grabs F11 at
# the WM level, so it overrides any app's own F11
# handling (e.g. Firefox's own fullscreen) while focused under i3.
# Uses bindcode (keycode 95), not bindsym F11: this keymap defines keycode
# 95's higher shift-levels as XF86Switch_VT_11, and keysym-based lookup was
# observed (via xev) to synthesize F11 with a phantom Alt_L held down, which
# is why plain `bindsym F11` never matched (i3 saw "Alt+F11", not "F11").
# bindcode matches the physical key directly and sidesteps that layer.
# (Separate issue, now fixed: $mod+Shift+q and other Super shortcuts going
# unresponsive was ibus having silently switched back to the chewing/
# Chinese engine -- see toggle-ibus.sh -- not related to this F11 bug.)
bindcode 95 exec --no-startup-id python3 ~/.config/i3/maximize-toggle.py
bindsym $mod+Shift+m exec --no-startup-id python3 ~/.config/i3/maximize-toggle.py
bindsym $mod+m exec --no-startup-id python3 ~/.config/i3/maximize-toggle.py
# Moved off $mod+Shift+space (was here originally) to free that combo for
# the Bar Selector below -- matches gh0stzk's sxhkd exactly, where
# super+shift+space is Bar Selector and bspwm's floating toggle lives
# elsewhere (bspwm has no single-key tiled<->floating toggle to collide
# with in the first place).
bindsym $mod+Shift+f floating toggle
# Minimize: moves the focused window to the scratchpad (hidden). $mod+minus
# brings back the most recently minimized one (i3's own `scratchpad show`,
# with no window criteria, cycles through whatever's in the scratchpad if
# pressed again).
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+grave focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+r mode "resize"

# ---------------------------------------------------------------------------
# Workspaces
# ---------------------------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ---------------------------------------------------------------------------
# i3 control
# ---------------------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Resize without entering the mode (idea from gh0stzk's sxhkd: super+ctrl+
# arrows/hjkl). $mod+Ctrl+* is unused elsewhere in this file. Same directions
# as the resize mode above: h/Left shrink width, l/Right grow width, etc.
bindsym $mod+Ctrl+h resize shrink width 40 px or 4 ppt
bindsym $mod+Ctrl+j resize grow height 40 px or 4 ppt
bindsym $mod+Ctrl+k resize shrink height 40 px or 4 ppt
bindsym $mod+Ctrl+l resize grow width 40 px or 4 ppt
bindsym $mod+Ctrl+Left resize shrink width 40 px or 4 ppt
bindsym $mod+Ctrl+Down resize grow height 40 px or 4 ppt
bindsym $mod+Ctrl+Up resize shrink height 40 px or 4 ppt
bindsym $mod+Ctrl+Right resize grow width 40 px or 4 ppt

# ---------------------------------------------------------------------------
# Screenshot / lock
# ---------------------------------------------------------------------------
bindsym Print exec flameshot gui
bindsym $mod+Print exec flameshot screen
bindsym $mod+Shift+Print exec flameshot full
# Kali's stock XFCE default screenshot shortcut (Shift+Super+S -> flameshot
# gui -c, region-select with clipboard copy) is normally enforced by
# xfce4-settings-helper reading its xfconf shortcut channel -- that daemon
# doesn't run under bare i3, so it silently stopped firing. Rebound directly
# here so it works without depending on that XFCE daemon.
bindsym $mod+Shift+s exec --no-startup-id flameshot gui -c
bindsym $mod+Shift+x exec --no-startup-id betterlockscreen -l dimblur

# ---------------------------------------------------------------------------
# Volume / brightness (media keys)
# ---------------------------------------------------------------------------
# Same wpctl / brightnessctl commands as before, now wrapped by osd.sh so each
# press also shows a dunst progress-bar notification (pattern borrowed from
# gh0stzk's Volume / Brightness scripts). See ~/.config/i3/osd.sh.
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/osd.sh vol-up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/osd.sh vol-down
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/osd.sh vol-mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.config/i3/osd.sh mic-mute
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/osd.sh bright-up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/osd.sh bright-down

# Media transport keys (playerctl talks to any MPRIS player: Spotify,
# Firefox, mpv, ...). Silently does nothing if playerctl isn't installed.
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl pause
bindsym XF86AudioStop exec --no-startup-id playerctl stop
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ---------------------------------------------------------------------------
# Floating rules
# ---------------------------------------------------------------------------
# XFCE/Windows-style default: normal application windows float by default
# instead of auto-tiling (no 50/50 split on 2nd window, no re-divide on 3rd).
# This is a global catch-all -- to go back to i3's normal tiling-by-default
# behavior later, just comment out this one line; the specific app rules
# below stay harmless (re-enabling floating on an already-floating window is
# a no-op) so nothing else needs to change either way.
# Sizing itself is NOT done here (just the floating enable) -- new windows
# default to filling the usable area below the top bar, same as one press
# of F11/$mod+m. That's handled by ~/.config/i3/default-size.py (daemon
# started in the Autostart block above), which needs the output size and
# the top bar's height at map time -- not expressible as a static
# `resize set` here.
for_window [class="^.*"] floating enable, border pixel 2

# Kept for clarity/documentation even though the catch-all above already
# covers them -- also acts as the always-float list if the catch-all is
# ever removed.
for_window [class="Pavucontrol"] floating enable
for_window [class="RiceAudioPopup"] floating enable, border pixel 0
for_window [class="Arandr"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="flameshot"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="Xfce4-power-manager-settings"] floating enable
for_window [title="branchdialog"] floating enable
for_window [class="i3_nagbar"] floating enable

# Workspace 4 is the one native-tiling workspace -- workspaces 1-3 (and any
# other) keep the floating-by-default catch-all above. This rule runs after
# it and wins, so new windows opened on workspace 4 tile normally (2nd
# window auto-splits 50/50, 3rd keeps tiling, no floating).
# LIMITATION: for_window matches a window's workspace at map time (when it
# first appears). A window opened elsewhere and later moved to workspace 4
# with $mod+Shift+4 does NOT retroactively become tiled -- it stays
# floating, since this rule never re-evaluates for it.
for_window [workspace="^4$"] floating disable

# ---------------------------------------------------------------------------
# Desktop / Taskbar / Help -- ported from gh0stzk's RiceSelector/BarSelector/
# Help/profilecard (see ~/.config/i3/keybinds.conf for the full cheatsheet
# data). Combos match gh0stzk's sxhkdrc exactly (alt+F1, alt+space,
# super+shift+space) -- floating toggle was moved off super+shift+space to
# $mod+Shift+f to make room (see that bindsym further up).
# ---------------------------------------------------------------------------
# Desktop (theme) selector -- "桌面選擇" -- gh0stzk: alt + @space
bindsym Mod1+space exec --no-startup-id ~/.config/rice/rice-selector.sh
# Taskbar (bar style) selector -- "taskbar選擇" -- gh0stzk: super + shift + @space
# -- independent of the color theme above, see apply-theme.sh's BAR STYLE
# OVERRIDE comment.
bindsym $mod+Shift+space exec --no-startup-id ~/.config/rice/bar-selector.sh
# User card -- "用戶卡排" (no dedicated sxhkd binding in gh0stzk -- their
# usercard is a profilecard panel opened by clicking its own eww dock icon,
# not a hotkey -- kept on $mod+u, our own choice)
bindsym $mod+u exec --no-startup-id ~/.config/rice/usercard.sh
# Keybindings cheatsheet -- "快捷鍵一覽" -- gh0stzk: alt + F1
# Bound by physical keycode 67 (F1) so XKB's multi-level F1/XF86Switch_VT_1
# mapping doesn't prevent i3 from grabbing Alt+F1 (same pattern as F11 above).
bindcode Mod1+67 exec --no-startup-id ~/.config/i3/help.sh
# Wallpaper picker (independent of the theme/bar-style choices above)
bindsym $mod+Shift+w exec --no-startup-id ~/.config/rice/wallpaper-selector.sh
# Hide/show the taskbar (top bar + dock, whichever is running)
bindsym $mod+Shift+u exec --no-startup-id ~/.config/i3/hide-bar-toggle.sh
# Restore a specific hidden/minimized window by name instead of blindly
# cycling scratchpad show
bindsym Ctrl+Mod1+h exec --no-startup-id ~/.config/i3/scratchpad-menu.sh
# Soft reload -- re-apply the current rice and restart just its daemons
# (polybar/dock/picom/dunst/geometry daemons), no full i3 restart
bindsym Ctrl+Mod1+$mod+s exec --no-startup-id ~/.config/rice/reload-rice.sh

# ---------------------------------------------------------------------------
# Network / Bluetooth
# ---------------------------------------------------------------------------
bindsym $mod+Shift+n exec --no-startup-id nm-connection-editor
bindsym $mod+Shift+b exec --no-startup-id blueman-manager

# ---------------------------------------------------------------------------
# Window transparency -- Ctrl+Mod1+{plus,minus,t}, same combo gh0stzk's
# sxhkd uses, nothing else in this file claims Ctrl+Mod1+*. Uses
# transparency.sh, NOT picom-trans directly -- see that script's own
# comment: picom-trans's active-window detection is unreliable under i3's
# reparenting model (verified live: it silently set opacity on an
# unrelated invisible window instead of the focused one).
# ---------------------------------------------------------------------------
# "plus" requires an actual physical Shift on this (and most) keyboards --
# keycode 21 is "equal" unshifted, "plus" only with Shift held -- i3 matches
# the literal keysym+modifier combo, so "Ctrl+Mod1+plus" with no Shift in
# the binding never fires even though Ctrl+Alt+Shift+= is what a user
# naturally presses for "+" (verified live: a bare Ctrl+Mod1+plus binding
# silently never matched; adding Shift made it fire immediately). Also
# bound to "equal" so pressing the key without bothering with Shift works
# too.
bindsym Ctrl+Mod1+Shift+plus exec --no-startup-id ~/.config/i3/transparency.sh inc
bindsym Ctrl+Mod1+equal      exec --no-startup-id ~/.config/i3/transparency.sh inc
bindsym Ctrl+Mod1+minus exec --no-startup-id ~/.config/i3/transparency.sh dec
bindsym Ctrl+Mod1+t     exec --no-startup-id ~/.config/i3/transparency.sh reset

