# TEMPLATE for ~/.config/dunst/dunstrc -- edit THIS file for structural
# changes, edit ~/.config/rice/theme.conf for colors, then re-run
# ~/.config/rice/apply-theme.sh. Do not hand-edit color values here.

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (46, 48)
    scale = 0
    notification_limit = 5

    width = 320
    height = (0, 300)
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 1
    frame_color = "#FFFFFF"
    gap_size = 6
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_theme = "Papirus-Dark"

    sticky_history = yes
    history_length = 20
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 6
    ignore_dbusclose = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # Progress bar drawn for notifications carrying an int:value hint -- used
    # by ~/.config/i3/osd.sh for the volume / brightness OSD.
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    transparency = 9

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#0A0A0A"
    foreground = "#E8E8E8"
    frame_color = "#2E2E2E"
    timeout = 4

[urgency_normal]
    background = "#0A0A0A"
    foreground = "#E8E8E8"
    frame_color = "#FFFFFF"
    timeout = 6

[urgency_critical]
    background = "#0A0A0A"
    foreground = "#E8E8E8"
    frame_color = "#FF1855"
    timeout = 0

# Volume / brightness OSD (osd.sh): short-lived, never kept in history.
[osd]
    appname = osd
    history_ignore = yes
    timeout = 2
