// Kali dragon rendered as a REAL PNG via the Kitty graphics protocol -- not
// ASCII/Unicode art. Requires Kitty (or another kitty-graphics-protocol
// terminal); run with `fastfetch` inside kitty to see it.
// Image source: ~/Pictures/dragon.png -> dragon.png in this same directory,
// which is itself a symlink to whichever recolor matches the active rice
// preset (dragon-purple.png / dragon-green.png) -- repointed automatically
// by ~/.config/rice/switch-theme.sh alongside theme.conf, so the dragon
// always matches the current ACCENT color. Original silhouette derived
// from ~/Downloads/pngwing.com.png (the stock Kali dragon badge PNG), with
// the light-gray disc backing/drop-shadow removed; each color variant is
// just a flat RGB swap over that same alpha mask (see the recolor one-liner
// in the switch-theme.sh commit, or dragon-purple.png's original #00F0FF /
// dragon-green.png's #00FF41). Regenerate dragon-purple.png from the
// original source with the same threshold script if you ever swap in a
// different base image, then re-derive the other color variants from it.
//
// logo.type is "kitty-icat" (not "kitty"): fastfetch's own built-in "kitty"
// writer emits the raw graphics protocol with no tmux passthrough DCS
// wrapper, so it silently no-ops inside tmux even with `allow-passthrough
// on` in tmux.conf. "kitty-icat" shells out to `kitten icat`, which detects
// $TMUX itself and wraps the escape sequence correctly -- confirmed via
// `script -qc 'kitten icat ...'` capturing a `\ePtmux;...` wrapper that the
// plain "kitty" type never produced.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-icat",
        "source": "~/Pictures/dragon.png",
        "width": 34,
        "height": 18,
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "white",
                "host": "cyan"
            }
        },
        "break",
        {
            "type": "os",
            "key": " OS",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": " UP",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": " PKG",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " SHELL",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "cpu",
            "key": " CPU",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": " GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": " MEM",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": " DISK",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "localip",
            "key": " IP",
            "keyColor": "green"
        },
        "break",
        "colors"
    ]
}
